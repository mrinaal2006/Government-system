# Settings for docker-compose.worker.yml (the background server for the Vercel deployment).
# Copy to .env.worker and fill in. Values must match the Vercel project's environment
# variables (same database, Redis, storage and encryption keys). Never commit .env.worker.

DEPLOYMENT_DISTRICT_NAME=
DEPLOYMENT_STATE_NAME=
GRIEVANCE_REFERENCE_PREFIX=DGI

# Managed PostgreSQL with PostGIS
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=dgimews
DATABASE_SSLMODE=verify-full
DATABASE_APP_USER=dgimews_app
DATABASE_APP_PASSWORD=
DATABASE_MIGRATION_USER=dgimews_migrator
DATABASE_MIGRATION_PASSWORD=

# Managed Redis (TLS)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=true

# S3-compatible private storage
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=dgimews-files
STORAGE_REGION=ap-south-1
STORAGE_SECURE=true

# Must be identical to the Vercel project's values
DATA_ENCRYPTION_KEY=
LOOKUP_HMAC_KEY=
