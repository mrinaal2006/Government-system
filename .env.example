# DG-IMEWS environment configuration template.
# Copy to .env and replace EVERY value marked CHANGE_ME. Never commit .env.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Staging/production refuse to start with short or placeholder secrets.

# --- Application ---------------------------------------------------------------
# development | test | staging | production
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json
ALLOWED_HOSTS=localhost,127.0.0.1,api

# --- Deployment identity (official header). Leave blank until confirmed. -------
DEPLOYMENT_DISTRICT_NAME=
DEPLOYMENT_DISTRICT_NAME_LOCAL=
DEPLOYMENT_STATE_NAME=
DEPLOYMENT_STATE_NAME_LOCAL=

# --- PostgreSQL / PostGIS ------------------------------------------------------
DATABASE_NAME=dgimews
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
DATABASE_MIGRATION_USER=dgimews_migrator
DATABASE_MIGRATION_PASSWORD=CHANGE_ME
DATABASE_APP_USER=dgimews_app
DATABASE_APP_PASSWORD=CHANGE_ME
# use verify-full when the database is on another host
DATABASE_SSLMODE=prefer

# --- Redis ---------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME

# --- Application-layer encryption (citizen personal data, MFA secrets) ----------
# Losing DATA_ENCRYPTION_KEY makes encrypted data unrecoverable: back it up separately.
DATA_ENCRYPTION_KEY=CHANGE_ME
# Comma-separated previous keys, kept only during key rotation.
DATA_ENCRYPTION_PREVIOUS_KEYS=
LOOKUP_HMAC_KEY=CHANGE_ME

# --- Sessions -------------------------------------------------------------------
# Leave unset: cookies are Secure everywhere except development/test.
SESSION_COOKIE_SECURE=

# --- Object storage (Garage, S3-compatible, private) ----------------------------
STORAGE_BUCKET=dgimews-files
STORAGE_ACCESS_KEY=CHANGE_ME_GARAGE_KEY_ID
STORAGE_SECRET_KEY=CHANGE_ME_HEX64
GARAGE_RPC_SECRET=CHANGE_ME_HEX64
GARAGE_ADMIN_TOKEN=CHANGE_ME

# --- Malware scanning: "clamav" (required in production) or "none" (dev only) ---
MALWARE_SCANNER=none

# --- Monitoring: bearer token for /api/v1/system/metrics ------------------------
METRICS_TOKEN=CHANGE_ME

# --- Grievance reference prefix, e.g. district code (REF/2026/000001) -----------
GRIEVANCE_REFERENCE_PREFIX=DGI

# --- Web -----------------------------------------------------------------------
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

# --- Optional: building behind a TLS-inspecting proxy --------------------------
# BUILD_NETWORK=host
# BUILD_HTTPS_PROXY=http://proxy.example:3128
# BUILD_CA_BUNDLE=/path/to/proxy-ca.pem
