# DG-IMEWS environment configuration template.
# Copy to .env and replace EVERY value marked CHANGE_ME. Never commit .env.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Staging/production refuse to start with short or placeholder secrets.

# --- Application ---------------------------------------------------------------
# development | test | staging | production
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json
ALLOWED_HOSTS=localhost,127.0.0.1,api

# --- Deployment identity (official header). Leave blank until confirmed. -------
DEPLOYMENT_DISTRICT_NAME=
DEPLOYMENT_DISTRICT_NAME_LOCAL=
DEPLOYMENT_STATE_NAME=
DEPLOYMENT_STATE_NAME_LOCAL=

# --- PostgreSQL / PostGIS ------------------------------------------------------
DATABASE_NAME=dgimews
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
DATABASE_MIGRATION_USER=dgimews_migrator
DATABASE_MIGRATION_PASSWORD=CHANGE_ME
DATABASE_APP_USER=dgimews_app
DATABASE_APP_PASSWORD=CHANGE_ME
# use verify-full when the database is on another host
DATABASE_SSLMODE=prefer

# --- Redis ---------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME

# --- Web -----------------------------------------------------------------------
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

# --- Optional: building behind a TLS-inspecting proxy --------------------------
# BUILD_NETWORK=host
# BUILD_HTTPS_PROXY=http://proxy.example:3128
# BUILD_CA_BUNDLE=/path/to/proxy-ca.pem
